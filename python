<!-- Command palette -->
<div class="palette-overlay" id="paletteOverlay">
  <div class="palette">
    <div class="palette-input-row">
      <span class="palette-prompt">&gt;&gt;&gt;</span>
      <input type="text" class="palette-input" id="paletteInput" placeholder="Digite o nome de um capítulo..." autocomplete="off">
