        <pre><span class="tok-kw">import</span> math
<span class="tok-kw">from</span> datetime <span class="tok-kw">import</span> date

<span class="tok-fn">print</span>(math.sqrt(16))
<span class="tok-fn">print</span>(math.pi)
<span class="tok-fn">print</span>(date.today())</pre>
