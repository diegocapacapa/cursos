<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aprenda Python — do zero ao primeiro projeto</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600&display=swap');

  :root{
    --bg: #0e1116;
    --panel: #151a22;
    --panel-2: #1b212b;
    --panel-3: #202836;
    --line: #262e3a;
    --text: #dfe4ea;
    --muted: #8b93a3;
    --blue: #4B8BBE;
    --blue-bright: #6fb3e6;
    --yellow: #FFD43B;
    --green: #7ec699;
    --red: #e07a7a;
    --radius: 4px;
    --sidew: 296px;
    --topbarh: 52px;
    --crumbh: 42px;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    background: var(--bg);
    color: var(--text);
    font-family: 'Source Sans 3', sans-serif;
    line-height: 1.6;
  }

  h1,h2,h3, .disp{ font-family: 'Space Grotesk', sans-serif; color: #fff; margin: 0; letter-spacing: -0.01em; }
  code, pre, .mono{ font-family: 'JetBrains Mono', monospace; }
  a{ color: var(--blue-bright); }
  button{ font-family: inherit; }
  svg{ display:block; }

  /* ===== TOP SCROLL PROGRESS ===== */
  .scrollbar{ position: fixed; top: 0; left: 0; height: 2px; background: linear-gradient(90deg, var(--blue), var(--yellow)); width: 0%; z-index: 100; transition: width .08s linear; }

  /* ===== TOPBAR (mobile) ===== */
  .topbar{
    display: none; position: sticky; top: 0; z-index: 40; height: var(--topbarh);
    background: var(--panel); border-bottom: 1px solid var(--line);
    align-items: center; justify-content: space-between; padding: 0 14px;
  }
  .topbar .tmark{ font-family:'JetBrains Mono', monospace; color: var(--yellow); font-size: 13px; }
  .topbar .tbtns{ display:flex; gap: 8px; }
  .iconbtn{
    width: 32px; height: 32px; background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--text); display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 14px;
  }
  .iconbtn:hover{ border-color: var(--blue-bright); }

  /* ===== LAYOUT ===== */
  .shell{ display: grid; grid-template-columns: var(--sidew) 1fr; min-height: 100vh; }

  nav.side{
    background: var(--panel); border-right: 1px solid var(--line);
    padding: 0 0 30px 0; position: sticky; top: 0; height: 100vh;
    display: flex; flex-direction: column;
  }

  .side-head{ padding: 22px 20px 16px 20px; border-bottom: 1px solid var(--line); }
  .side-head-row{ display: flex; align-items: center; gap: 14px; }
  .ringwrap{ position: relative; width: 44px; height: 44px; flex-shrink: 0; }
  .ringwrap svg{ transform: rotate(-90deg); }
  .ring-bg{ fill: none; stroke: var(--panel-3); stroke-width: 4; }
  .ring-fg{ fill: none; stroke: var(--yellow); stroke-width: 4; stroke-linecap: round; transition: stroke-dashoffset .4s ease; }
  .ring-pct{ position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family:'JetBrains Mono', monospace; font-size: 10px; color: var(--text); }

  .brand .mark{ font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: var(--yellow); display:block; margin-bottom: 4px; }
  .brand h1{ font-size: 18px; font-weight: 700; }
  .brand p{ color: var(--muted); font-size: 12px; margin-top: 3px; }

  .quickrow{ display: flex; gap: 8px; margin-top: 14px; }
  .qbtn{
    flex: 1; background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--muted); font-size: 11.5px; font-family:'JetBrains Mono', monospace; padding: 7px 8px;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .qbtn:hover{ color: var(--text); border-color: var(--blue-bright); }
  .qbtn .kbd{ background: var(--panel-3); border: 1px solid var(--line); border-radius: 3px; padding: 0 4px; font-size: 10px; color: var(--muted); }
  .qbtn.active{ color: var(--yellow); border-color: var(--yellow); }

  .searchwrap{ padding: 14px 20px 6px 20px; }
  .searchbox{ width: 100%; background: var(--panel-2); border: 1px solid var(--line); border-radius: var(--radius); color: var(--text); padding: 8px 10px; font-size: 13px; font-family: 'JetBrains Mono', monospace; }
  .searchbox::placeholder{ color: var(--muted); }
  .searchbox:focus{ outline: none; border-color: var(--blue-bright); }

  .navscroll{ flex: 1; overflow-y: auto; padding-top: 4px; }

  .navgroup{ border-bottom: 1px solid rgba(38,46,58,0.5); }
  .navgroup-head{
    width: 100%; display: flex; align-items: center; gap: 10px; padding: 11px 20px;
    background: none; border: none; color: var(--text); cursor: pointer; text-align: left;
  }
  .navgroup-head:hover{ background: var(--panel-2); }
  .navgroup-head .chev{ font-size: 10px; color: var(--muted); transition: transform .18s ease; width: 10px; }
  .navgroup.collapsed .chev{ transform: rotate(-90deg); }
  .navgroup-head .glabel{ font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .03em; color: var(--muted); flex: 1; }
  .navgroup-head .gcount{ font-family:'JetBrains Mono', monospace; font-size: 10.5px; color: var(--muted); }
  .gprogress{ height: 3px; background: var(--panel-3); margin: 0 20px 8px 20px; border-radius: 2px; overflow: hidden; }
  .gprogress-fill{ height: 100%; background: var(--blue-bright); width: 0%; transition: width .3s ease; }
  .navgroup-body{ overflow: hidden; max-height: 800px; transition: max-height .25s ease; }
  .navgroup.collapsed .navgroup-body{ max-height: 0; }
  .navgroup.collapsed .gprogress{ display: none; }

  .navlink{
    display: flex; align-items: center; gap: 9px; padding: 7px 20px 7px 20px; color: var(--muted);
    text-decoration: none; font-size: 13.5px; border-left: 2px solid transparent;
    transition: color .15s, border-color .15s, background .15s;
  }
  .navlink .idx{ font-family:'JetBrains Mono', monospace; font-size: 11px; color: var(--blue-bright); width: 18px; flex-shrink:0; }
  .navlink .lbl{ flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .navlink .star{ opacity: .25; font-size: 12px; cursor: pointer; padding: 2px; }
  .navlink .star:hover{ opacity: .8; }
  .navlink .star.on{ opacity: 1; color: var(--yellow); }
  .navlink .check{ font-size: 11px; color: var(--green); opacity: 0; width: 12px; }
  .navlink.done .check{ opacity: 1; }
  .navlink:hover{ color: var(--text); background: var(--panel-2); }
  .navlink.active{ color: #fff; border-left-color: var(--yellow); background: var(--panel-2); }
  .navlink.hidden{ display: none; }
  .navgroup.hidden{ display: none; }

  .side-foot{ padding: 12px 20px 0 20px; border-top: 1px solid var(--line); }
  .continue-btn{
    display: none; width: 100%; text-align: left; background: var(--panel-2); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 10px 12px; color: var(--text); cursor: pointer; margin-top: 12px;
  }
  .continue-btn.show{ display: block; }
  .continue-btn .cb-lbl{ font-family:'JetBrains Mono', monospace; font-size: 10px; color: var(--muted); display:block; margin-bottom: 3px; }
  .continue-btn .cb-chap{ font-size: 13px; color: var(--blue-bright); }
  .continue-btn:hover{ border-color: var(--blue-bright); }

  /* ===== COMMAND PALETTE ===== */
  .palette-overlay{
    display: none; position: fixed; inset: 0; background: rgba(6,8,11,0.72); z-index: 90;
    align-items: flex-start; justify-content: center; padding-top: 12vh;
  }
  .palette-overlay.show{ display: flex; }
  .palette{
    width: 560px; max-width: 90vw; background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
    box-shadow: 0 20px 60px rgba(0,0,0,.5); overflow: hidden;
  }
  .palette-input-row{ display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .palette-prompt{ font-family:'JetBrains Mono', monospace; color: var(--yellow); font-size: 15px; }
  .palette-input{ flex: 1; background: none; border: none; color: var(--text); font-size: 15px; font-family:'JetBrains Mono', monospace; }
  .palette-input:focus{ outline: none; }
  .palette-esc{ font-family:'JetBrains Mono', monospace; font-size: 10px; color: var(--muted); border: 1px solid var(--line); border-radius: 3px; padding: 2px 5px; }
  .palette-results{ max-height: 340px; overflow-y: auto; padding: 6px; }
  .palette-item{
    display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: var(--radius);
    cursor: pointer; color: var(--text); font-size: 14px;
  }
  .palette-item .pi-idx{ font-family:'JetBrains Mono', monospace; color: var(--blue-bright); font-size: 11.5px; width: 22px; }
  .palette-item .pi-group{ margin-left: auto; font-family:'JetBrains Mono', monospace; font-size: 10.5px; color: var(--muted); }
  .palette-item.sel{ background: var(--panel-2); }
  .palette-item.sel .pi-group{ color: var(--yellow); }
  .palette-empty{ padding: 24px; text-align: center; color: var(--muted); font-size: 13.5px; }

  main{ padding: 0; max-width: 880px; }

  /* Breadcrumb */
  .crumbbar{
    position: sticky; top: 0; z-index: 20; height: var(--crumbh); background: rgba(14,17,22,0.92);
    backdrop-filter: blur(6px); border-bottom: 1px solid var(--line); display: flex; align-items: center;
    padding: 0 56px; gap: 8px; font-family:'JetBrains Mono', monospace; font-size: 12px; color: var(--muted);
  }
  .crumbbar .cg{ color: var(--muted); }
  .crumbbar .cc{ color: var(--text); }
  .crumbbar .sep{ color: var(--line); }

  .hero{ padding: 70px 56px 50px 56px; border-bottom: 1px solid var(--line); position: relative; overflow: hidden; }
  .hero::before{ content: ">>> "; position: absolute; right: 40px; top: 28px; font-family: 'JetBrains Mono', monospace; font-size: 110px; color: var(--panel-2); z-index: 0; line-height: 1; }
  .hero-inner{ position: relative; z-index: 1; }
  .hero .kicker{ font-family: 'JetBrains Mono', monospace; color: var(--yellow); font-size: 13px; margin-bottom: 14px; display: block; }
  .hero h1{ font-size: 41px; line-height: 1.13; max-width: 640px; }
  .hero p.lead{ color: var(--muted); font-size: 16px; max-width: 540px; margin-top: 16px; }
  .hero .startbtn{ display: inline-block; margin-top: 24px; background: var(--yellow); color: #14181f; font-weight: 600; padding: 11px 20px; border-radius: var(--radius); text-decoration: none; font-size: 14px; }
  .hero .startbtn:hover{ background: #ffdd66; }
  .hero .paletteopen{ display: inline-flex; align-items:center; gap: 8px; margin-top: 24px; margin-left: 10px; background: none; border: 1px solid var(--line); color: var(--muted); padding: 10px 16px; border-radius: var(--radius); font-size: 13px; cursor: pointer; }
  .hero .paletteopen:hover{ border-color: var(--blue-bright); color: var(--text); }
  .hero .paletteopen .kbd{ background: var(--panel-3); border: 1px solid var(--line); border-radius: 3px; padding: 1px 5px; font-family:'JetBrains Mono', monospace; font-size: 10.5px; }

  .progress-wrap{ margin-top: 30px; max-width: 480px; }
  .progress-bar{ height: 6px; background: var(--panel-2); border-radius: 3px; overflow: hidden; }
  .progress-fill{ height: 100%; background: linear-gradient(90deg, var(--blue), var(--yellow)); width: 0%; transition: width .4s ease; }
  .progress-label{ font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--muted); margin-top: 8px; display:flex; justify-content:space-between; align-items:center; gap: 10px;}
  .progress-label .reset{ background:none; border:1px solid var(--line); color: var(--muted); border-radius: 3px; padding: 3px 9px; cursor: pointer; font-family:'JetBrains Mono', monospace; font-size: 11px;}
  .progress-label .reset:hover{ color: var(--red); border-color: var(--red); }

  section.topic{ padding: 50px 56px; border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--crumbh) + 16px); }
  .topic-head{ display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .topic-num{ font-family: 'JetBrains Mono', monospace; color: var(--blue-bright); font-size: 15px; }
  .topic h2{ font-size: 25px; flex: 1; }
  .topic-star{ background: none; border: 1px solid var(--line); border-radius: var(--radius); width: 30px; height: 30px; color: var(--muted); cursor: pointer; font-size: 14px; }
  .topic-star:hover{ border-color: var(--yellow); }
  .topic-star.on{ color: var(--yellow); border-color: var(--yellow); }
  .topic .dek{ color: var(--muted); font-size: 15px; max-width: 640px; margin: 10px 0 22px 0; }

  .topic p{ max-width: 660px; color: #c7ccd6; font-size: 15.5px; }
  .topic ul{ max-width: 640px; color: #c7ccd6; font-size: 15.5px; padding-left: 20px; }
  .topic li{ margin-bottom: 6px; }
  .topic table{ border-collapse: collapse; max-width: 660px; margin: 16px 0; font-size: 14px; }
  .topic th, .topic td{ border: 1px solid var(--line); padding: 8px 12px; text-align: left; color: #c7ccd6; }
  .topic th{ color: var(--text); background: var(--panel-2); font-family:'JetBrains Mono', monospace; font-size: 12.5px; }

  .codeblock{ background: #0b0d12; border: 1px solid var(--line); border-radius: var(--radius); margin: 18px 0 12px 0; overflow: hidden; max-width: 660px; }
  .codeblock .cb-top{ display: flex; justify-content: space-between; align-items: center; padding: 8px 14px; background: var(--panel-2); border-bottom: 1px solid var(--line); }
  .codeblock .cb-title{ font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--muted); }
  .cb-actions{ display: flex; gap: 8px; }
  .cb-btn{ font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--blue-bright); background: none; border: 1px solid var(--line); border-radius: 3px; padding: 3px 9px; cursor: pointer; }
  .cb-btn:hover{ border-color: var(--blue-bright); }
  .cb-btn.run{ color: var(--green); }
  .cb-btn.run:hover{ border-color: var(--green); }
  .codeblock pre{ margin: 0; padding: 16px 18px; font-size: 13.5px; overflow-x: auto; color: #cfe3d8; }
  .tok-kw{ color: var(--blue-bright); }
  .tok-str{ color: var(--yellow); }
  .tok-com{ color: var(--muted); font-style: italic; }
  .tok-fn{ color: #a3d9ff; }

  .out{ max-width: 660px; background: #0b0d12; border: 1px solid var(--line); border-radius: var(--radius); padding: 0 16px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--green); margin-bottom: 22px; max-height: 0; opacity: 0; overflow: hidden; transition: max-height .35s ease, opacity .3s ease, padding .35s ease; }
  .out.shown{ max-height: 320px; opacity: 1; padding: 12px 16px; }
  .out .lbl{ color: var(--muted); display:block; font-size: 11px; margin-bottom: 6px; }

  .callout{ max-width: 640px; border-left: 3px solid var(--yellow); background: var(--panel-2); padding: 12px 16px; border-radius: 0 var(--radius) var(--radius) 0; font-size: 14px; color: #d7dbe2; margin: 18px 0; }
  .callout.warn{ border-left-color: var(--red); }
  .callout b{ color: var(--yellow); }
  .callout.warn b{ color: var(--red); }

  .quiz{ max-width: 640px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; margin-top: 24px; }
  .quiz .qtitle{ font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: var(--blue-bright); margin-bottom: 10px; }
  .quiz p.q{ font-size: 15px; color: var(--text); margin-bottom: 14px; }
  .quiz .opts{ display: flex; flex-direction: column; gap: 8px; }
  .quiz .opt{ text-align: left; background: var(--panel-2); border: 1px solid var(--line); color: var(--text); padding: 10px 14px; border-radius: var(--radius); cursor: pointer; font-size: 14px; }
  .quiz .opt:hover{ border-color: var(--blue-bright); }
  .quiz .opt.correct{ border-color: var(--green); background: rgba(126,198,153,0.12); color: var(--green); }
  .quiz .opt.wrong{ border-color: var(--red); background: rgba(224,122,122,0.12); color: var(--red); }
  .quiz .feedback{ margin-top: 12px; font-size: 13.5px; color: var(--muted); display:none; }

  .chapnav{ display: flex; justify-content: space-between; align-items: center; max-width: 660px; margin-top: 34px; gap: 12px; }
  .chapnav a{ flex: 1; display: block; border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 16px; text-decoration: none; color: var(--text); background: var(--panel-2); font-size: 13.5px; }
  .chapnav a:hover{ border-color: var(--blue-bright); }
  .chapnav a.next{ text-align: right; }
  .chapnav .lbl2{ display:block; font-family:'JetBrains Mono', monospace; font-size: 10.5px; color: var(--muted); margin-bottom: 3px; }

  .marker-done{ display:inline-flex; align-items:center; gap:6px; font-family:'JetBrains Mono', monospace; font-size: 11px; color: var(--muted); margin-top: 22px; cursor: pointer; }
  .marker-done input{ accent-color: var(--yellow); }

  footer{ padding: 46px 56px 90px 56px; color: var(--muted); font-size: 14px; }
  footer .fmark{ font-family: 'JetBrains Mono', monospace; color: var(--yellow); }
  footer .reslist{ margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 640px; }
  footer .reslist a{ display:block; border: 1px solid var(--line); border-radius: var(--radius); padding: 10px 14px; font-size: 13.5px; }
  footer .reslist a:hover{ border-color: var(--blue-bright); }

  .toast{ position: fixed; bottom: 22px; right: 22px; background: var(--panel-2); border: 1px solid var(--green); color: var(--green); padding: 10px 16px; border-radius: var(--radius); font-family:'JetBrains Mono', monospace; font-size: 13px; opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s; z-index: 60; pointer-events:none; }
  .toast.show{ opacity: 1; transform: translateY(0); }

  ::-webkit-scrollbar{ width: 9px; height: 9px; }
  ::-webkit-scrollbar-track{ background: transparent; }
  ::-webkit-scrollbar-thumb{ background: var(--panel-3); border-radius: 5px; }
  ::-webkit-scrollbar-thumb:hover{ background: var(--line); }

  @media (max-width: 900px){
    .topbar{ display: flex; }
    .shell{ grid-template-columns: 1fr; }
    nav.side{ position: fixed; left: 0; top: var(--topbarh); height: calc(100vh - var(--topbarh)); width: 88%; max-width: 340px; transform: translateX(-100%); transition: transform .25s ease; z-index: 50; box-shadow: 4px 0 24px rgba(0,0,0,.4); }
    nav.side.open{ transform: translateX(0); }
    .overlay{ display:none; position: fixed; inset: 0; top: var(--topbarh); background: rgba(0,0,0,.5); z-index: 45; }
    .overlay.show{ display: block; }
    .crumbbar{ padding: 0 22px; }
    .hero{ padding: 40px 22px 32px 22px; }
    .hero h1{ font-size: 28px; }
    .hero::before{ display: none; }
    section.topic{ padding: 32px 22px; }
    footer{ padding: 40px 22px 70px 22px; }
    footer .reslist{ grid-template-columns: 1fr; }
    .palette{ width: 92vw; }
  }
</style>
</head>
<body>

<div class="scrollbar" id="scrollbar"></div>

<div class="topbar">
  <span class="tmark">&gt;&gt;&gt; curso_python</span>
  <div class="tbtns">
    <button class="iconbtn" id="paletteBtnMobile" aria-label="Buscar">⌕</button>
    <button class="iconbtn" id="hamburger" aria-label="Abrir menu">☰</button>
  </div>
</div>
<div class="overlay" id="overlay"></div>

<div class="shell">

  <nav class="side" id="sidenav">
    <div class="side-head">
      <div class="side-head-row">
        <div class="ringwrap">
          <svg width="44" height="44" viewBox="0 0 44 44">
            <circle class="ring-bg" cx="22" cy="22" r="18"></circle>
            <circle class="ring-fg" id="ringFg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="113"></circle>
          </svg>
          <div class="ring-pct" id="ringPct">0%</div>
        </div>
        <div class="brand">
          <span class="mark">&gt;&gt;&gt; import aprendizado</span>
          <h1>Curso de Python</h1>
          <p>18 capítulos · do zero ao projeto</p>
        </div>
      </div>

      <div class="quickrow">
        <button class="qbtn" id="paletteBtn">⌕ buscar <span class="kbd">⌘K</span></button>
        <button class="qbtn" id="favBtn">★ favoritos</button>
      </div>
    </div>

    <div class="searchwrap">
      <input type="text" class="searchbox" id="searchbox" placeholder="Filtrar capítulos...">
    </div>

    <div class="navscroll" id="navscroll">
      <div class="navgroup" data-group="fundamentos">
        <button class="navgroup-head"><span class="chev">▾</span><span class="glabel">FUNDAMENTOS</span><span class="gcount">0/4</span></button>
        <div class="gprogress"><div class="gprogress-fill"></div></div>
        <div class="navgroup-body">
          <a href="#intro" class="navlink" data-target="intro"><span class="idx">00</span><span class="lbl">O que é Python</span><span class="check">✓</span><span class="star" data-star="intro">★</span></a>
          <a href="#variaveis" class="navlink" data-target="variaveis"><span class="idx">01</span><span class="lbl">Variáveis e tipos</span><span class="check">✓</span><span class="star" data-star="variaveis">★</span></a>
          <a href="#operadores" class="navlink" data-target="operadores"><span class="idx">02</span><span class="lbl">Operadores</span><span class="check">✓</span><span class="star" data-star="operadores">★</span></a>
          <a href="#strings" class="navlink" data-target="strings"><span class="idx">03</span><span class="lbl">Texto (strings)</span><span class="check">✓</span><span class="star" data-star="strings">★</span></a>
        </div>
      </div>

      <div class="navgroup" data-group="controle">
        <button class="navgroup-head"><span class="chev">▾</span><span class="glabel">CONTROLE DE FLUXO</span><span class="gcount">0/2</span></button>
