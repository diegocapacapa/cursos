<div class="toast" id="toast">Progresso salvo</div>

<script>
  const STORAGE_KEY = 'curso_python_progresso';
  const FAV_KEY = 'curso_python_favoritos';
  const COLLAPSE_KEY = 'curso_python_grupos_colapsados';
  const LAST_KEY = 'curso_python_ultimo_capitulo';

  function loadJSON(key){ try{ return JSON.parse(localStorage.getItem(key)) || {}; }catch(e){ return {}; } }
  function saveJSON(key, data){ try{ localStorage.setItem(key, JSON.stringify(data)); }catch(e){} }

  let progress = loadJSON(STORAGE_KEY);
  let favorites = loadJSON(FAV_KEY);
  let collapsed = loadJSON(COLLAPSE_KEY);

  function showToast(msg){
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(showToast._t);
    showToast._t = setTimeout(() => t.classList.remove('show'), 1600);
  }

  function runCode(btn){
    const block = btn.closest('.codeblock');
    const out = block.nextElementSibling;
    if (out && out.classList.contains('out')) out.classList.toggle('shown');
  }
  function copyCode(btn){
    const pre = btn.closest('.codeblock').querySelector('pre');
    navigator.clipboard.writeText(pre.innerText).then(() => {
      const old = btn.textContent;
      btn.textContent = 'copiado!';
      setTimeout(() => btn.textContent = old, 1400);
    });
  }

  // ===== Quiz =====
  document.querySelectorAll('.quiz').forEach(quiz => {
    const opts = quiz.querySelectorAll('.opt');
    const feedback = quiz.querySelector('.feedback');
    let answered = false;
    opts.forEach(opt => {
      opt.addEventListener('click', () => {
        if (answered) return;
        answered = true;
        const isCorrect = opt.dataset.correct === 'true';
        opts.forEach(o => { if (o.dataset.correct === 'true') o.classList.add('correct'); else if (o === opt) o.classList.add('wrong'); });
        feedback.style.display = 'block';
        feedback.textContent = isCorrect ? 'Isso mesmo — pode seguir para o próximo capítulo.' : 'Não foi essa — a resposta certa está marcada em verde.';
        if (isCorrect) {
          const section = quiz.closest('section.topic');
          const box = section.querySelector('.marker-done input');
          if (box && !box.checked) { box.checked = true; box.dispatchEvent(new Event('change')); }
        }
      });
    });
  });

  // ===== Progress + groups =====
  const boxes = document.querySelectorAll('.marker-done input');
  const fill = document.getElementById('progressFill');
  const label = document.getElementById('progressLabel');
  const ringFg = document.getElementById('ringFg');
  const ringPct = document.getElementById('ringPct');
  const RING_CIRC = 113;
  const groups = document.querySelectorAll('.navgroup');

  function updateProgress(save){
    const total = boxes.length;
    let done = 0;
    boxes.forEach(b => {
      const key = b.dataset.mark;
      if (save) progress[key] = b.checked;
      if (progress[key]) { b.checked = true; done++; }
      const navlink = document.querySelector('.navlink[data-target="'+key+'"]');
      if (navlink) navlink.classList.toggle('done', !!progress[key]);
    });
    const pct = Math.round(done/total*100);
    fill.style.width = pct + '%';
    label.textContent = done + ' de ' + total + ' capítulos concluídos';
    ringFg.style.strokeDashoffset = RING_CIRC - (RING_CIRC * pct/100);
    ringPct.textContent = pct + '%';

    groups.forEach(g => {
      const links = g.querySelectorAll('.navlink');
      const doneCount = Array.from(links).filter(l => progress[l.dataset.target]).length;
      g.querySelector('.gcount').textContent = doneCount + '/' + links.length;
      g.querySelector('.gprogress-fill').style.width = (doneCount/links.length*100) + '%';
    });
  }
  boxes.forEach(b => b.addEventListener('change', () => { updateProgress(true); saveJSON(STORAGE_KEY, progress); showToast('Progresso salvo'); }));
  updateProgress(false);

  document.getElementById('resetBtn').addEventListener('click', () => {
    if(!confirm('Reiniciar todo o progresso salvo?')) return;
    progress = {};
    boxes.forEach(b => b.checked = false);
    saveJSON(STORAGE_KEY, progress);
    updateProgress(false);
    showToast('Progresso reiniciado');
  });

  // ===== Favorites =====
  function applyFavorites(){
    document.querySelectorAll('.star[data-star]').forEach(s => s.classList.toggle('on', !!favorites[s.dataset.star]));
    document.querySelectorAll('.topic-star[data-star-target]').forEach(s => s.classList.toggle('on', !!favorites[s.dataset.starTarget]));
  }
  function toggleFavorite(key){
    favorites[key] = !favorites[key];
    saveJSON(FAV_KEY, favorites);
    applyFavorites();
  }
  document.querySelectorAll('.star[data-star]').forEach(s => {
    s.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); toggleFavorite(s.dataset.star); });
  });
  document.querySelectorAll('.topic-star[data-star-target]').forEach(s => {
    s.addEventListener('click', () => toggleFavorite(s.dataset.starTarget));
  });
  applyFavorites();

  let favOnly = false;
  document.getElementById('favBtn').addEventListener('click', function(){
    favOnly = !favOnly;
    this.classList.toggle('active', favOnly);
    document.querySelectorAll('.navlink').forEach(l => {
      const key = l.dataset.target;
      l.classList.toggle('hidden', favOnly && !favorites[key]);
    });
    groups.forEach(g => {
      const visible = g.querySelectorAll('.navlink:not(.hidden)').length;
      g.classList.toggle('hidden', favOnly && visible === 0);
      if (favOnly) g.classList.remove('collapsed');
    });
  });

  // ===== Collapsible groups =====
  groups.forEach(g => {
    const key = g.dataset.group;
    if (collapsed[key]) g.classList.add('collapsed');
    g.querySelector('.navgroup-head').addEventListener('click', () => {
      g.classList.toggle('collapsed');
      collapsed[key] = g.classList.contains('collapsed');
      saveJSON(COLLAPSE_KEY, collapsed);
    });
  });

  // ===== Active link / breadcrumb / last visited =====
  const links = document.querySelectorAll('.navlink');
  const sections = document.querySelectorAll('section.topic');
  const crumbGroup = document.getElementById('crumbGroup');
  const crumbChap = document.getElementById('crumbChap');
  const continueBtn = document.getElementById('continueBtn');
  const continueChap = document.getElementById('continueChap');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting){
        const id = entry.target.id;
        links.forEach(l => l.classList.toggle('active', l.dataset.target === id));
        crumbGroup.textContent = entry.target.dataset.group;
        crumbChap.textContent = entry.target.dataset.title;
        saveJSON(LAST_KEY, { id: id, title: entry.target.dataset.title });
      }
    });
  }, { rootMargin: '-15% 0px -70% 0px' });
  sections.forEach(s => observer.observe(s));

  const lastVisited = loadJSON(LAST_KEY);
  if (lastVisited && lastVisited.id){
    continueChap.textContent = lastVisited.title;
    continueBtn.classList.add('show');
    continueBtn.addEventListener('click', () => { window.location.hash = lastVisited.id; });
  }

  // ===== Search filter (sidebar) =====
  const searchbox = document.getElementById('searchbox');
  searchbox.addEventListener('input', () => {
    const q = searchbox.value.trim().toLowerCase();
    links.forEach(l => {
      const text = l.textContent.toLowerCase();
      const passFav = !favOnly || favorites[l.dataset.target];
      l.classList.toggle('hidden', (q.length > 0 && !text.includes(q)) || !passFav);
    });
    groups.forEach(g => {
      const visible = g.querySelectorAll('.navlink:not(.hidden)').length;
      g.classList.toggle('hidden', visible === 0);
      if (q.length > 0) g.classList.remove('collapsed');
    });
  });

  // ===== Command palette =====
  const allChapters = Array.from(sections).map(s => ({ id: s.id, title: s.dataset.title, group: s.dataset.group }));
  const paletteOverlay = document.getElementById('paletteOverlay');
  const paletteInput = document.getElementById('paletteInput');
  const paletteResults = document.getElementById('paletteResults');
  let paletteSel = 0;
  let paletteFiltered = allChapters;

  function renderPalette(){
    const q = paletteInput.value.trim().toLowerCase();
    paletteFiltered = allChapters.filter(c => c.title.toLowerCase().includes(q) || c.group.toLowerCase().includes(q));
    if (paletteFiltered.length === 0){
      paletteResults.innerHTML = '<div class="palette-empty">Nenhum capítulo encontrado.</div>';
      return;
    }
    paletteSel = Math.min(paletteSel, paletteFiltered.length - 1);
    paletteResults.innerHTML = paletteFiltered.map((c, i) => {
      const idx = allChapters.indexOf(c);
      const num = String(idx).padStart(2,'0');
      return '<div class="palette-item'+(i===paletteSel?' sel':'')+'" data-id="'+c.id+'" data-i="'+i+'"><span class="pi-idx">'+num+'</span><span>'+c.title+'</span><span class="pi-group">'+c.group+'</span></div>';
    }).join('');
  }

  function openPalette(){
    paletteOverlay.classList.add('show');
    paletteInput.value = '';
    paletteSel = 0;
    renderPalette();
    setTimeout(() => paletteInput.focus(), 30);
  }
  function closePalette(){ paletteOverlay.classList.remove('show'); }
  function goToChapter(id){ window.location.hash = id; closePalette(); }

  document.getElementById('paletteBtn').addEventListener('click', openPalette);
  document.getElementById('paletteBtnHero').addEventListener('click', openPalette);
  document.getElementById('paletteBtnMobile').addEventListener('click', openPalette);
  paletteOverlay.addEventListener('click', (e) => { if (e.target === paletteOverlay) closePalette(); });
  paletteInput.addEventListener('input', renderPalette);
  paletteResults.addEventListener('click', (e) => {
    const item = e.target.closest('.palette-item');
    if (item) goToChapter(item.dataset.id);
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'){
      e.preventDefault();
      paletteOverlay.classList.contains('show') ? closePalette() : openPalette();
      return;
    }
    if (paletteOverlay.classList.contains('show')){
      if (e.key === 'Escape'){ closePalette(); }
      else if (e.key === 'ArrowDown'){ e.preventDefault(); paletteSel = Math.min(paletteSel+1, paletteFiltered.length-1); renderPalette(); }
      else if (e.key === 'ArrowUp'){ e.preventDefault(); paletteSel = Math.max(paletteSel-1, 0); renderPalette(); }
      else if (e.key === 'Enter'){ e.preventDefault(); if (paletteFiltered[paletteSel]) goToChapter(paletteFiltered[paletteSel].id); }
      return;
    }
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT'){
      e.preventDefault(); searchbox.focus();
    }
  });

  // ===== Mobile menu =====
  const hamburger = document.getElementById('hamburger');
  const sidenav = document.getElementById('sidenav');
  const overlay = document.getElementById('overlay');
  function closeMenu(){ sidenav.classList.remove('open'); overlay.classList.remove('show'); }
  hamburger.addEventListener('click', () => { sidenav.classList.toggle('open'); overlay.classList.toggle('show'); });
  overlay.addEventListener('click', closeMenu);
  links.forEach(l => l.addEventListener('click', closeMenu));

  // ===== Top scroll progress bar =====
  const scrollbar = document.getElementById('scrollbar');
  window.addEventListener('scroll', () => {
    const h = document.documentElement;
    const scrolled = (h.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
    scrollbar.style.width = scrolled + '%';
  });
</script>

